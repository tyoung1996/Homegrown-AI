generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ADULT
  CHILD
}

// what someone asked for: a film, a whole show, one season, one episode
enum MediaKind {
  MOVIE
  SERIES
  SEASON
  EPISODE
}

// where a request is up to. the family-facing wording lives in the ui
enum MediaStatus {
  REQUESTED   // on the list, nothing has happened yet
  SEARCHING   // a source is looking for it
  ACQUIRING   // a source is bringing it in (a rip, a recording, a copy)
  IMPORTING   // the file landed and is being filed into the library
  AVAILABLE   // it is in the library and ready to watch
  UNAVAILABLE // no source could provide it
  CANCELLED
}

model User {
  id            String           @id @default(cuid())
  username      String           @unique
  displayName   String
  passwordHash  String
  role          Role             @default(CHILD)
  // the Jellyfin account that is this person — never a room's account.
  // set by an admin; unset means no personal watch history for them
  jellyfinUserId String?         @unique
  createdAt     DateTime         @default(now())
  conversations Conversation[]
  images        ImageGeneration[]
  memories      Memory[]
  mediaRequests MediaRequest[]
}

// saved people for the Studio — a named reference photo the image models
// can use to put that person into new scenes; shared with the whole family
model Person {
  id          String        @id @default(cuid())
  name        String
  description String?       // one-line look description the vision model writes, used in prompts
  imagePath   String        // primary reference photo
  createdBy   String
  createdAt   DateTime      @default(now())
  photos      PersonPhoto[]
}

// extra reference angles for a person — more photos, better likeness
model PersonPhoto {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  imagePath String
  createdAt DateTime @default(now())
}

// the shared family calendar — anyone in the house can add to it, and the
// assistant adds to it from chat
model Event {
  id        String    @id @default(cuid())
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  allDay    Boolean   @default(false)
  location  String?
  notes     String?
  who       String?   // free text: "Levi", "everyone"
  createdBy String
  createdAt DateTime  @default(now())
}

// app-wide settings, e.g. which chat model is active
model Setting {
  key   String @id
  value String
}

// long-term memory; rows with no userId are shared family-wide
model Memory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New chat")
  summary   String?   // one line, written by the assistant after replies
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  imagePath      String?
  // anything the message carries besides text: a picker the family taps to
  // choose films or episodes, or the list of things a reply put on the list
  data           Json?
  createdAt      DateTime     @default(now())
}

model ImageGeneration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String
  status    String   @default("pending")
  filePath  String?
  createdAt DateTime @default(now())
}

model InstalledModel {
  id        String   @id @default(cuid())
  name      String   @unique
  sizeBytes BigInt?
  addedAt   DateTime @default(now())
}

// something a family member asked to have in the library, and how far along
// it is. the catalog id is TMDB's, which is also what jellyfin stores, so a
// request can be matched against what is already on the shelf
model MediaRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          MediaKind
  catalogId     Int         // tmdb id of the film or the series
  title         String      // "The Office"
  label         String      // what the family sees: "The Office - S3E7"
  year          Int?
  posterUrl     String?
  overview      String?
  seasonNumber  Int?
  episodeNumber Int?
  status        MediaStatus @default(REQUESTED)
  statusNote    String?     // one plain line for the family
  adminNote     String?     // the technical why, for the admin panel only
  retryAfter    DateTime?   // when an automatic provider may be asked again
  source        String?     // which acquisition provider picked it up
  sourceRef     String?     // that provider's own id for it, for correlation
  filePath      String?     // where it ended up in the library
  jellyfinId    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([catalogId])
}
