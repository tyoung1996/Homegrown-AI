# copy to api/.env and fill in — the install script does this for you

# postgres connection (the install script creates this user and database)
DATABASE_URL="postgresql://circuitbarn:CHANGE_ME@localhost:5432/circuitbarn"

# long random string; signs login tokens. `openssl rand -hex 32` makes a good one
JWT_SECRET=CHANGE_ME

# where the models run (defaults are fine on a single machine)
OLLAMA_URL=http://127.0.0.1:11434
COMFY_URL=http://127.0.0.1:8188

# models — the app installs these from the UI; these are just the defaults it reaches for
CHAT_MODEL=qwen3:8b
VISION_MODEL=qwen2.5vl:7b

# image generation checkpoints (see scripts/install-images.sh)
SD_CHECKPOINT=RealVisXL_Lightning.safetensors
SD_CHECKPOINT_HQ=RealVisXL_V5.safetensors

# where uploaded photos and generated images are stored
IMAGES_DIR=/home/YOUR_USER/circuit-barn/data/images

# ---- movie night (all optional; the app hides what isn't set up) ----

# looking up film and show titles, from themoviedb.org — free, make an account
# and copy the API key. without it the app still plays and imports, it just
# can't search for titles
TMDB_API_KEY=

# the jellyfin server that holds the library. the key comes from
# jellyfin > dashboard > api keys. it stays on the server, never in a browser
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=

# the library folder jellyfin reads, and the folder new files are picked up
# from. anything dropped in MEDIA_DROPBOX that you are allowed to copy gets
# renamed, filed under MEDIA_ROOT/Movies or /Shows, and handed to jellyfin
MEDIA_ROOT=/srv/media
MEDIA_DROPBOX=/srv/media/_incoming

# the folders inside MEDIA_ROOT that jellyfin scans. if you already have a
# library, set these to its folder names so imports land in it
MEDIA_MOVIES_SUBDIR=Movies
MEDIA_SHOWS_SUBDIR=Shows
