# copy to api/.env and fill in — the install script does this for you

# postgres connection (the install script creates this user and database)
DATABASE_URL="postgresql://circuitbarn:CHANGE_ME@localhost:5432/circuitbarn"

# long random string; signs login tokens. `openssl rand -hex 32` makes a good one
JWT_SECRET=CHANGE_ME

# where the models run (defaults are fine on a single machine)
OLLAMA_URL=http://127.0.0.1:11434
COMFY_URL=http://127.0.0.1:8188

# models — the app installs these from the UI; these are just the defaults it reaches for
CHAT_MODEL=qwen3:8b
VISION_MODEL=qwen2.5vl:7b

# image generation checkpoints (see scripts/install-images.sh)
SD_CHECKPOINT=RealVisXL_Lightning.safetensors
SD_CHECKPOINT_HQ=RealVisXL_V5.safetensors

# where uploaded photos and generated images are stored
IMAGES_DIR=/home/YOUR_USER/circuit-barn/data/images
